# AVefi Importer — Direktzugriff auf den Anwendungscode via URL verbieten.
# Alle echten Requests laufen über /index.php (das die Dateien serverseitig per
# PHP-include lädt); /app/... wird nie direkt per HTTP benötigt.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (Fallback)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
