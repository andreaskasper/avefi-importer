# AVefi Importer — Beispielkonfiguration.
#
# Diese Datei enthaelt KEINE Zugangsdaten. Sie zeigt, welche Variablen es gibt
# und welche Werte im Entwicklungsbetrieb gelten. Zum Benutzen kopieren:
#
#     cp .env.example .env
#
# .env ist in .gitignore und gehoert nicht ins Repository.
#
# WICHTIG — zwei Schreibweisen, je nach Betriebsart:
#
#   Entwicklung (npm run dev):   die Namen unten gelten unveraendert.
#   Auslieferung (npm run build + npm start): Datenbank und Sitzungsgeheimnis
#   muessen mit dem Praefix NUXT_ gesetzt werden (NUXT_DB_HOST, ...). Nitro
#   uebernimmt zur Laufzeit nur NUXT_-praefigierte Werte in die runtimeConfig;
#   die unpraefigierten Namen werden beim BAUEN gelesen und fest eingebacken.
#   Naeheres in docs/deployment.md, Abschnitt „Umgebungsvariablen".

# --- Datenbank ---------------------------------------------------------------
# Im Auslieferungsbetrieb zusaetzlich als NUXT_DB_HOST usw. setzen.
DB_HOST=db
DB_PORT=5432
DB_NAME=avefi
DB_USER=avefi
DB_PASS=bitte-eigenes-passwort-setzen

# --- Ablage ------------------------------------------------------------------
# Verzeichnis fuer hochgeladene Dateien und erzeugte avefi.v1.json.
# Muss fuer den Anwendungsbenutzer beschreibbar sein.
FILES_PATH=/mnt/files

# --- Validierungsdienst ------------------------------------------------------
# Adresse des efi-conv-Sidecars. Im Compose-Verbund der Dienstname.
EFI_CONV_URL=http://efi-conv:8000

# Herkunft von efi-conv beim Bauen des Sidecars. Damit laesst sich auf den
# Stand aus Leistungspaket A oder auf einen festen Commit zeigen.
EFI_CONV_REPO=github.com/AV-EFI/efi-conv.git
EFI_CONV_REF=main

# --- Sitzung -----------------------------------------------------------------
# Schluessel fuer die verschluesselten Sitzungscookies. Mindestens 32 Zeichen;
# kuerzere Werte werden aufgefuellt, was die Sicherheit nicht erhoeht.
# Eigenen Wert erzeugen:  openssl rand -base64 48
# Im Auslieferungsbetrieb zusaetzlich als NUXT_SESSION_SECRET setzen.
SESSION_SECRET=hier-einen-eigenen-zufallswert-von-mindestens-32-zeichen-eintragen

# --- Hintergrundprozess ------------------------------------------------------
# Sekunden, nach denen sich der Worker selbst beendet. Docker zieht ihn mit
# restart:always neu hoch, dadurch laeuft er nie lange mit altem Code.
WORKER_MAX_UPTIME=600

# --- Normdaten (optional, vertraglich nicht geschuldet) ----------------------
# Standard ist aus. Nur einschalten, wenn Anreicherung gewuenscht ist und
# ausgehende HTTP-Verbindungen zu GND, Wikidata und VIAF erlaubt sind.
AUTHORITY_ENABLED=false
# Obergrenze der Nachschlagevorgaenge je Konvertierung.
AUTHORITY_LIMIT=500

# --- Deployment --------------------------------------------------------------
# Nur fuer die Traefik-Regel in docker-compose.dev.yml. Die Anwendung selbst
# kennt keine feste Domain.
APP_DOMAIN=avefiimporter.example.org
